{
  "name": "roomia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-next-cache.mjs && node node_modules/next/dist/bin/next dev",
    "back": "cd ../roomia-ai-backend && ./venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000",
    "build": "node scripts/ensure-next-cache.mjs && node node_modules/next/dist/bin/next build",
    "start": "node scripts/ensure-next-cache.mjs && node node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "generate-presets": "npx tsx scripts/generate-room-presets.ts",
    "generate-presets:dump": "npx tsx scripts/generate-room-presets.ts --dump --out=scripts/data/room-presets.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.107.0",
    "camera-controls": "^3.1.2",
    "konva": "^10.3.0",
    "nanoid": "^5.1.16",
    "next": "16.2.7",
    "next-intl": "^4.13.5",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.4",
    "resend": "^6.12.4",
    "sharp": "^0.35.2",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
