{
  "name": "roomia-desktop",
  "productName": "Roomia",
  "version": "0.1.1",
  "private": true,
  "description": "Roomia Studio : rendus, visite 360\u00b0 et plans sur votre propre carte graphique",
  "author": "Roomia",
  "main": "main.js",
  "scripts": {
    "server:linux": "node scripts/package-server.mjs --platform=linux",
    "server:win": "node scripts/package-server.mjs --platform=win32",
    "start": "electron .",
    "dist:linux": "node scripts/package-server.mjs --platform=linux && electron-builder --linux dir",
    "dist:win": "node scripts/package-server.mjs --platform=win32 && electron-builder --win nsis --x64",
    "dist:win:zip": "node scripts/package-server.mjs --platform=win32 && electron-builder --win zip --x64 -c.artifactName='Roomia-${version}-windows-x64.${ext}'"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.roomia.desktop",
    "productName": "Roomia",
    "copyright": "Roomia",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "engine.js",
      "splash.html",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "stage",
          "to": ".",
          "filter": [
            "app-server/**/*"
          ]
        },
        {
          "from": "pylib-win32",
          "to": "pylib",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "runtime-win32",
          "to": "runtime",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Roomia",
      "artifactName": "Roomia-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "dir",
      "category": "Graphics",
      "extraResources": [
        {
          "from": "stage",
          "to": ".",
          "filter": [
            "app-server/**/*"
          ]
        },
        {
          "from": "pylib-linux",
          "to": "pylib",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "runtime-linux",
          "to": "runtime",
          "filter": [
            "**/*"
          ]
        }
      ]
    }
  }
}
